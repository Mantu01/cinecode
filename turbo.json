{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "npm_execpath",
    "BUN_INSTALL",
    "BUN_CONFIG",
    "STEM_SEPARATOR_PYTHON",
    "OPENAI_API_KEY",
    "ELEVENLABS_API_KEY",
    "AZURE_SPEECH_KEY",
    "AZURE_SPEECH_ENDPOINT",
    "COQUI_API_KEY",
    "COQUI_TTS_URL",
    "NODE_ENV",
    "CINECODE_TEST_NODE_VERSION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "spikes/out/**"]
    }
  }
}
