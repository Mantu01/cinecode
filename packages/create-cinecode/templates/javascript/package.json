{
  "name": "{{PROJECT_NAME}}",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "cinecode dev --config ./cinecode.config.{{CONFIG_EXT}}",
    "preview": "cinecode preview --config ./cinecode.config.{{CONFIG_EXT}}",
    "render": "cinecode render --config ./cinecode.config.{{CONFIG_EXT}}",
    "render:all": "cinecode render --all --config ./cinecode.config.{{CONFIG_EXT}}",
    "still": "cinecode still --config ./cinecode.config.{{CONFIG_EXT}} --timeline main --frame 0",
    "validate": "cinecode validate --config ./cinecode.config.{{CONFIG_EXT}}",
    "clean": "cinecode clean --config ./cinecode.config.{{CONFIG_EXT}}",
    "typecheck": "node --check main.js"
  },
  "dependencies": {
    "cinecode": "{{CINECODE_DEP}}"
  },
  "devDependencies": {
    "@types/node": "^24.19.1"
  }
}
