{
  "name": "create-cinecode",
  "version": "1.0.0",
  "description": "Scaffold a Cinecode project",
  "license": "MIT",
  "author": {
    "name": "Cinecode"
  },
  "homepage": "https://github.com/Mantu01/cinecode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mantu01/cinecode.git",
    "directory": "packages/create-cinecode"
  },
  "bugs": {
    "url": "https://github.com/Mantu01/cinecode/issues"
  },
  "keywords": [
    "cinecode",
    "create",
    "scaffold",
    "video",
    "animation"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "create-cinecode": "./dist/esm/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "check:templates": "node ./scripts/generate-templates.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.19.1"
  }
}
