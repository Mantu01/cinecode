{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "extends": {
      "type": "string"
    },
    "schemaVersion": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "sourceDir": {
          "type": "string",
          "minLength": 1
        },
        "outputDir": {
          "type": "string",
          "minLength": 1
        },
        "cacheDir": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "video": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "defaultDuration": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "string"
            }
          ]
        },
        "background": {
          "type": "string",
          "pattern": "^#([A-Fa-f0-9]{3}|[A-Fa-f0-9]{6}|[A-Fa-f0-9]{8})$"
        }
      },
      "additionalProperties": false
    },
    "images": {
      "type": "object",
      "properties": {
        "defaultFormat": {
          "type": "string",
          "enum": [
            "png",
            "jpg",
            "webp",
            "svg"
          ]
        },
        "quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "scaleFactor": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "dev": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "host": {
          "type": "string"
        },
        "open": {
          "type": "boolean"
        },
        "hmr": {
          "type": "boolean"
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "sourceDir": {
      "type": "string"
    },
    "outputDir": {
      "type": "string"
    },
    "cacheDir": {
      "type": "string"
    },
    "cloudMedia": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    "render": {
      "type": "object",
      "properties": {
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 120
        },
        "resolution": {
          "type": "string",
          "pattern": "^(\\d+x\\d+|720p|1080p|1440p|4k|vertical-1080|square-1080)$"
        },
        "format": {
          "type": "string",
          "enum": [
            "mp4",
            "webm",
            "prores",
            "mkv",
            "avi",
            "gif",
            "apng",
            "png",
            "jpg",
            "webp",
            "avif",
            "pdf",
            "webm-alpha",
            "prores-alpha"
          ]
        },
        "quality": {
          "type": "string",
          "enum": [
            "draft",
            "preview",
            "medium",
            "final",
            "lossless",
            "low",
            "high"
          ]
        },
        "codec": {
          "type": "string",
          "enum": [
            "h264",
            "h265",
            "av1",
            "prores",
            "vp9",
            "ffv1",
            "utvideo"
          ]
        },
        "crf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "preset": {
          "type": "string",
          "enum": [
            "ultrafast",
            "superfast",
            "veryfast",
            "faster",
            "fast",
            "medium",
            "slow",
            "slower",
            "veryslow"
          ]
        },
        "hardwareAcceleration": {
          "type": "string",
          "enum": [
            "auto",
            "nvenc",
            "videotoolbox",
            "qsv",
            "off"
          ]
        },
        "concurrency": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "string",
              "const": "auto"
            }
          ]
        },
        "chunkSize": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "alpha": {
          "type": "boolean"
        },
        "twoPass": {
          "type": "boolean"
        },
        "platformPreset": {
          "type": "string",
          "enum": [
            "youtube-1080p",
            "youtube-4k",
            "tiktok",
            "instagram-reels",
            "instagram-post",
            "twitter",
            "custom"
          ]
        },
        "bitrate": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "colorManagement": {
          "type": "object",
          "properties": {
            "workingColorSpace": {
              "type": "string",
              "enum": [
                "srgb",
                "linear-srgb",
                "rec709",
                "acescg"
              ]
            },
            "outputColorSpace": {
              "type": "string",
              "enum": [
                "srgb",
                "rec709",
                "display-p3",
                "rec2020"
              ]
            },
            "enabled": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "audio": {
      "type": "object",
      "properties": {
        "sampleRate": {
          "anyOf": [
            {
              "type": "number",
              "const": 22050
            },
            {
              "type": "number",
              "const": 44100
            },
            {
              "type": "number",
              "const": 48000
            },
            {
              "type": "number",
              "const": 96000
            }
          ]
        },
        "channels": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 6
            }
          ]
        },
        "masterVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "family": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": [
              "number",
              "string"
            ]
          },
          "style": {
            "type": "string"
          }
        },
        "required": [
          "family",
          "src"
        ],
        "additionalProperties": false
      }
    },
    "concurrency": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "string",
          "const": "auto"
        }
      ]
    },
    "overwrite": {
      "type": "boolean"
    },
    "gitignore": {
      "type": "boolean"
    },
    "plugins": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "options": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "enabled": {
                "type": "boolean"
              }
            },
            "required": [
              "source"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "pluginPrecedence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "autoDiscoverPlugins": {
      "type": "boolean"
    },
    "ignorePatterns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "composition": {}
  },
  "additionalProperties": false,
  "$id": "https://cinecode.dev/schemas/cinecode.schema.json",
  "title": "Cinecode Configuration",
  "description": "JSON Schema for Cinecode configs, generated from the runtime Zod schema."
}
