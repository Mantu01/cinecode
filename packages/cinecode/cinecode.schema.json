{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cinecode.dev/schemas/cinecode.schema.json",
  "title": "Cinecode Configuration",
  "description": "JSON Schema for Cinecode configs and compositions. Generated from the public TypeScript types in src/core/types and src/config.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "sourceDir"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Schema reference for editor tooling."
    },
    "schemaVersion": {
      "type": "integer",
      "enum": [
        1,
        2
      ],
      "default": 2
    },
    "name": {
      "type": "string",
      "description": "Project name used as the output stem."
    },
    "extends": {
      "type": "string",
      "description": "Path to a base config file this config inherits from."
    },
    "project": {
      "$ref": "#/definitions/ProjectConfig"
    },
    "video": {
      "$ref": "#/definitions/VideoConfig"
    },
    "images": {
      "$ref": "#/definitions/ImageConfig"
    },
    "dev": {
      "$ref": "#/definitions/DevConfig"
    },
    "sourceDir": {
      "type": "string",
      "description": "Directory holding authored sources. Default: ./src."
    },
    "outputDir": {
      "type": "string",
      "description": "Directory receiving rendered artifacts. Default: ./output."
    },
    "cacheDir": {
      "type": "string",
      "description": "Directory holding render caches. Default: .cinecode/cache."
    },
    "cloudMedia": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/CloudMediaEntry"
      }
    },
    "render": {
      "$ref": "#/definitions/RenderConfig"
    },
    "audio": {
      "$ref": "#/definitions/AudioConfig"
    },
    "fonts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/FontEntry"
      }
    },
    "concurrency": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "string",
          "enum": [
            "auto"
          ]
        }
      ]
    },
    "logLevel": {
      "type": "string",
      "enum": [
        "silent",
        "error",
        "warn",
        "info",
        "debug"
      ]
    },
    "overwrite": {
      "type": "boolean"
    },
    "gitignore": {
      "type": "boolean"
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PluginConfigEntry"
      }
    },
    "autoDiscoverPlugins": {
      "type": "boolean",
      "description": "Scan node_modules for marked Cinecode plugin packages."
    },
    "ignorePatterns": {
      "type": "array",
      "items": {
        "type": "string",
        "description": "Glob pattern excluded from sync and media scanning."
      }
    },
    "composition": {
      "$ref": "#/definitions/Composition"
    }
  },
  "definitions": {
    "ProjectConfig": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Project name used as the default output stem."
        },
        "entry": {
          "type": "string",
          "description": "Root manifest entry. Default: ./main.ts."
        },
        "sourceDir": {
          "type": "string",
          "description": "Directory holding authored sources. Default: ./src."
        },
        "outputDir": {
          "type": "string",
          "description": "Directory receiving rendered artifacts. Default: ./output."
        },
        "cacheDir": {
          "type": "string",
          "description": "Directory holding render caches. Default: .cinecode/cache."
        }
      },
      "required": [
        "name",
        "entry",
        "sourceDir",
        "outputDir",
        "cacheDir"
      ],
      "additionalProperties": false
    },
    "VideoConfig": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "aspectRatio": {
          "type": "string",
          "enum": [
            "16:9",
            "9:16",
            "1:1",
            "4:3",
            "21:9"
          ]
        },
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "defaultDuration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "background": {
          "type": "string"
        },
        "colorSpace": {
          "type": "string",
          "enum": [
            "srgb",
            "rec709",
            "display-p3"
          ]
        },
        "pixelAspectRatio": {
          "type": "number"
        }
      },
      "required": [
        "title",
        "width",
        "height",
        "fps",
        "background"
      ],
      "additionalProperties": false
    },
    "ImageConfig": {
      "type": "object",
      "properties": {
        "defaultFormat": {
          "type": "string",
          "enum": [
            "png",
            "jpg",
            "webp",
            "svg"
          ]
        },
        "quality": {
          "type": "number",
          "minimum": 1,
          "maximum": 100
        },
        "scaleFactor": {
          "type": "number"
        }
      },
      "required": [
        "defaultFormat"
      ],
      "additionalProperties": false
    },
    "DevConfig": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "host": {
          "type": "string"
        },
        "open": {
          "type": "boolean"
        },
        "hmr": {
          "type": "boolean"
        },
        "historyDepth": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "required": [
        "port",
        "hmr"
      ],
      "additionalProperties": false
    },
    "RenderConfig": {
      "type": "object",
      "properties": {
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "resolution": {
          "type": "string",
          "description": "Resolution preset or WIDTHxHEIGHT."
        },
        "format": {
          "type": "string",
          "enum": [
            "mp4",
            "webm",
            "prores",
            "gif",
            "png",
            "pdf",
            "webm-alpha",
            "prores-alpha"
          ]
        },
        "background": {
          "type": "string"
        },
        "quality": {
          "type": "string",
          "enum": [
            "draft",
            "preview",
            "medium",
            "final",
            "lossless",
            "low",
            "high"
          ]
        },
        "codec": {
          "type": "string",
          "enum": [
            "h264",
            "h265",
            "av1",
            "prores",
            "vp9"
          ]
        },
        "crf": {
          "type": "number",
          "minimum": 0,
          "maximum": 63
        },
        "preset": {
          "type": "string",
          "enum": [
            "ultrafast",
            "superfast",
            "veryfast",
            "faster",
            "fast",
            "medium",
            "slow",
            "slower",
            "veryslow"
          ]
        },
        "hardwareAcceleration": {
          "type": "string",
          "enum": [
            "auto",
            "nvenc",
            "videotoolbox",
            "qsv",
            "off"
          ]
        },
        "concurrency": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "enum": [
                "auto"
              ]
            }
          ]
        },
        "chunkSize": {
          "type": "integer",
          "minimum": 1
        },
        "alpha": {
          "type": "boolean"
        },
        "twoPass": {
          "type": "boolean"
        },
        "platformPreset": {
          "type": "string",
          "enum": [
            "youtube-1080p",
            "youtube-4k",
            "tiktok",
            "instagram-reels",
            "instagram-post",
            "twitter",
            "custom"
          ]
        },
        "enforceAspectRatio": {
          "type": "boolean"
        },
        "variants": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "scaleFactor": {
                "type": "number"
              },
              "crf": {
                "type": "number"
              },
              "codec": {
                "type": "string",
                "enum": [
                  "h264",
                  "h265",
                  "av1",
                  "prores",
                  "vp9"
                ]
              }
            },
            "required": [
              "label"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "AudioConfig": {
      "type": "object",
      "properties": {
        "sampleRate": {
          "type": "integer",
          "enum": [
            22050,
            44100,
            48000,
            96000
          ]
        },
        "channels": {
          "type": "integer",
          "enum": [
            1,
            2
          ]
        },
        "masterVolume": {
          "type": "number"
        },
        "normalize": {
          "type": "boolean"
        },
        "limiter": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "thresholdDb": {
              "type": "number"
            }
          },
          "required": [
            "enabled",
            "thresholdDb"
          ],
          "additionalProperties": false
        },
        "sidechains": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "targetTrackName": {
                "type": "string"
              },
              "sidechainTrackName": {
                "type": "string"
              },
              "threshold": {
                "type": "number"
              },
              "ratio": {
                "type": "number"
              },
              "attackMs": {
                "type": "number"
              },
              "releaseMs": {
                "type": "number"
              }
            },
            "required": [
              "targetTrackName",
              "sidechainTrackName"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "FontEntry": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string"
        },
        "src": {
          "type": "string"
        },
        "weight": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "style": {
          "type": "string"
        }
      },
      "required": [
        "family",
        "src"
      ],
      "additionalProperties": false
    },
    "CloudMediaEntry": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "PluginConfigEntry": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "description": "Package name or path to the plugin module."
        },
        "options": {
          "type": "object",
          "additionalProperties": true
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "source"
      ],
      "additionalProperties": false
    },
    "EffectRef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Effect name, for example \"vignette\" or \"gaussian-blur\"."
        },
        "enabled": {
          "type": "boolean"
        },
        "from": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/KeyframeTrack"
          },
          "description": "Per-property keyframe tracks."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Reference to a registered effect and its parameters."
    },
    "TransitionRef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Transition name, built-in or registered by a plugin."
        },
        "duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "Transition duration in seconds or a duration string."
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "eased": {
          "type": "boolean"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "description": "Transition applied to the start or end of a visual clip."
    },
    "KeyframeTrack": {
      "type": "array",
      "description": "Tuple of [property, keyframes].",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        ]
      }
    },
    "Clip": {
      "type": "object",
      "properties": {
        "start": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "Start time in seconds or a duration string such as \"1.5s\"."
        },
        "end": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "End time in seconds or a duration string."
        },
        "duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "Clip duration in seconds or a duration string."
        },
        "type": {
          "type": "string",
          "enum": [
            "video",
            "image",
            "text",
            "shape",
            "solid",
            "group",
            "scene",
            "component",
            "audio",
            "sound",
            "tts",
            "model3d",
            "svg",
            "particle",
            "noise",
            "audioVisualizer",
            "chromaKey",
            "subtitle",
            "dataViz",
            "sticker",
            "gradientMesh",
            "meshWarp",
            "text3d",
            "multiCamera"
          ],
          "description": "Clip discriminant."
        },
        "src": {
          "type": "string",
          "description": "Media source path or URL. Resolvers handle http(s), s3 and gs schemes."
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "fit": {
          "type": "string",
          "enum": [
            "cover",
            "contain",
            "fill",
            "none",
            "scale-down"
          ]
        },
        "color": {
          "type": "string"
        },
        "background": {
          "type": "string"
        },
        "opacity": {
          "type": "number"
        },
        "volume": {
          "type": "number"
        },
        "muted": {
          "type": "boolean"
        },
        "loop": {
          "type": "boolean"
        },
        "speed": {
          "type": "number"
        },
        "reverse": {
          "type": "boolean"
        },
        "pan": {
          "type": "number"
        },
        "trimStart": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "trimEnd": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "fadeIn": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "fadeOut": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "sidechainFrom": {
          "type": "string",
          "description": "Track name that ducks this audio clip."
        },
        "position3d": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "z": {
              "type": "number"
            },
            "maxDistance": {
              "type": "number"
            },
            "rolloffFactor": {
              "type": "number"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "transform": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "scaleX": {
              "type": "number"
            },
            "scaleY": {
              "type": "number"
            },
            "rotation": {
              "type": "number"
            },
            "anchor": {
              "type": "string"
            },
            "skewX": {
              "type": "number"
            },
            "skewY": {
              "type": "number"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EffectRef"
          }
        },
        "transitionIn": {
          "$ref": "#/definitions/TransitionRef"
        },
        "transitionOut": {
          "$ref": "#/definitions/TransitionRef"
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/KeyframeTrack"
          },
          "description": "Animatable property tracks."
        },
        "mask": {
          "type": "object",
          "additionalProperties": true
        },
        "matte": {
          "type": "object",
          "additionalProperties": true
        },
        "dropShadow": {
          "type": "object",
          "additionalProperties": true
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          },
          "description": "Inline data points for data visualization clips."
        },
        "chartType": {
          "type": "string",
          "enum": [
            "bar",
            "line",
            "pie",
            "area",
            "scatter"
          ]
        },
        "emitter": {
          "type": "object",
          "additionalProperties": true
        },
        "noiseType": {
          "type": "string",
          "enum": [
            "simplex",
            "perlin",
            "worley",
            "fbm"
          ]
        },
        "svg": {
          "type": "string",
          "description": "Inline SVG source markup."
        },
        "style": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "description": "Any Cinecode clip. Type-specific fields are validated by the runtime."
    },
    "Track": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "visual",
            "audio",
            "subtitle"
          ],
          "description": "Track kind. Defaults to visual."
        },
        "name": {
          "type": "string"
        },
        "muted": {
          "type": "boolean"
        },
        "opacity": {
          "type": "number"
        },
        "blend": {
          "type": "string",
          "description": "Blend mode applied to the whole track."
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Clip"
          },
          "description": "Ordered clips on this track."
        }
      },
      "required": [
        "clips"
      ],
      "additionalProperties": false,
      "description": "A visual, audio or subtitle track."
    },
    "Timeline": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Track"
          }
        },
        "offset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "speed": {
          "type": "number"
        },
        "duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        }
      },
      "required": [
        "tracks"
      ],
      "additionalProperties": false
    },
    "TempoRegion": {
      "type": "object",
      "properties": {
        "start": {
          "type": "number"
        },
        "end": {
          "type": "number"
        },
        "fps": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "ChapterMarker": {
      "type": "object",
      "properties": {
        "time": {
          "type": "number",
          "description": "Seconds into the composition."
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "time",
        "title"
      ],
      "additionalProperties": false
    },
    "SplitRegion": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "sourceTrack": {
          "type": "string"
        },
        "fit": {
          "type": "string",
          "enum": [
            "cover",
            "contain",
            "fill",
            "none",
            "scale-down"
          ]
        },
        "padding": {
          "type": "number"
        },
        "roundedCorners": {
          "type": "number"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "SplitScreenConfig": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "string",
          "enum": [
            "side-by-side",
            "pip",
            "grid-2x2",
            "grid-3x3",
            "thirds-vertical",
            "thirds-horizontal",
            "custom"
          ]
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/SplitRegion"
          }
        },
        "padding": {
          "type": "number"
        }
      },
      "required": [
        "layout"
      ],
      "additionalProperties": false
    },
    "SkyboxConfig": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "cube",
            "equirectangular",
            "procedural"
          ]
        },
        "faces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "src": {
          "type": "string"
        },
        "exposure": {
          "type": "number"
        },
        "yaw": {
          "type": "number"
        },
        "pitch": {
          "type": "number"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "PostProcessEffectConfig": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "enabled": {
          "type": "boolean"
        },
        "priority": {
          "type": "number"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "PostProcessingConfig": {
      "type": "object",
      "properties": {
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/PostProcessEffectConfig"
          }
        },
        "previewMode": {
          "type": "boolean"
        },
        "resolutionScale": {
          "type": "number"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "Composition": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "background": {
          "type": "string"
        },
        "duration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            }
          ]
        },
        "tempo": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/TempoRegion"
          }
        },
        "audio": {
          "$ref": "#/definitions/AudioConfig"
        },
        "rootTimeline": {
          "$ref": "#/definitions/Timeline"
        },
        "splitScreen": {
          "$ref": "#/definitions/SplitScreenConfig"
        },
        "skybox": {
          "$ref": "#/definitions/SkyboxConfig"
        },
        "chapters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ChapterMarker"
          }
        },
        "postProcessing": {
          "$ref": "#/definitions/PostProcessingConfig"
        },
        "burnSubtitles": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "width",
        "height",
        "fps",
        "rootTimeline"
      ],
      "additionalProperties": false,
      "description": "A renderable composition."
    }
  }
}
