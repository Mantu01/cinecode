{
  "name": "cinecode",
  "version": "1.0.0",
  "description": "Code-first media generation framework",
  "license": "MIT",
  "author": {
    "name": "Cinecode"
  },
  "homepage": "https://github.com/Mantu01/cinecode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mantu01/cinecode.git",
    "directory": "packages/cinecode"
  },
  "bugs": {
    "url": "https://github.com/Mantu01/cinecode/issues"
  },
  "keywords": [
    "video",
    "animation",
    "renderer",
    "ffmpeg",
    "media",
    "codegen",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./cli/main.js": {
      "types": "./dist/esm/cli/main.d.ts",
      "import": "./dist/esm/cli/main.js"
    },
    "./core": { "types": "./dist/esm/core/index.d.ts", "import": "./dist/esm/core/index.js" },
    "./core/random": { "types": "./dist/esm/core/random/index.d.ts", "import": "./dist/esm/core/random/index.js" },
    "./core/keyframes": { "types": "./dist/esm/core/keyframes/index.d.ts", "import": "./dist/esm/core/keyframes/index.js" },
    "./random": { "types": "./dist/esm/core/random/index.d.ts", "import": "./dist/esm/core/random/index.js" },
    "./keyframes": { "types": "./dist/esm/core/keyframes/index.d.ts", "import": "./dist/esm/core/keyframes/index.js" },
    "./config": { "types": "./dist/esm/config/index.d.ts", "import": "./dist/esm/config/index.js" },
    "./renderer": { "types": "./dist/esm/renderer/index.d.ts", "import": "./dist/esm/renderer/index.js" },
    "./encoder": { "types": "./dist/esm/encoder/index.d.ts", "import": "./dist/esm/encoder/index.js" },
    "./media": { "types": "./dist/esm/media/index.d.ts", "import": "./dist/esm/media/index.js" },
    "./noise": { "types": "./dist/esm/noise/index.d.ts", "import": "./dist/esm/noise/index.js" },
    "./gradients": { "types": "./dist/esm/gradients/index.d.ts", "import": "./dist/esm/gradients/index.js" },
    "./warp": { "types": "./dist/esm/warp/index.d.ts", "import": "./dist/esm/warp/index.js" },
    "./stickers": { "types": "./dist/esm/stickers/index.d.ts", "import": "./dist/esm/stickers/index.js" },
    "./api": { "types": "./dist/esm/api/index.d.ts", "import": "./dist/esm/api/index.js" },
    "./errors": { "types": "./dist/esm/errors/index.d.ts", "import": "./dist/esm/errors/index.js" },
    "./manifest": { "types": "./dist/esm/manifest/index.d.ts", "import": "./dist/esm/manifest/index.js" },
    "./effects": { "types": "./dist/esm/effects/index.d.ts", "import": "./dist/esm/effects/index.js" },
    "./transitions": { "types": "./dist/esm/transitions/index.d.ts", "import": "./dist/esm/transitions/index.js" },
    "./audio": { "types": "./dist/esm/audio/index.d.ts", "import": "./dist/esm/audio/index.js" },
    "./plugin": { "types": "./dist/esm/plugin/index.d.ts", "import": "./dist/esm/plugin/index.js" },
    "./pipeline": { "types": "./dist/esm/pipeline/index.d.ts", "import": "./dist/esm/pipeline/index.js" },
    "./extensions": { "types": "./dist/esm/extensions/index.d.ts", "import": "./dist/esm/extensions/index.js" },
    "./observability": { "types": "./dist/esm/observability/index.d.ts", "import": "./dist/esm/observability/index.js" },
    "./binary": { "types": "./dist/esm/binary/resolver.d.ts", "import": "./dist/esm/binary/resolver.js" },
    "./model-3d": { "types": "./dist/esm/model-3d/index.d.ts", "import": "./dist/esm/model-3d/index.js" },
    "./text-3d": { "types": "./dist/esm/text-3d/index.d.ts", "import": "./dist/esm/text-3d/index.js" },
    "./particles": { "types": "./dist/esm/particles/index.d.ts", "import": "./dist/esm/particles/index.js" },
    "./midi": { "types": "./dist/esm/midi/index.d.ts", "import": "./dist/esm/midi/index.js" },
    "./tts": { "types": "./dist/esm/tts/index.d.ts", "import": "./dist/esm/tts/index.js" },
    "./svg": { "types": "./dist/esm/svg/index.d.ts", "import": "./dist/esm/svg/index.js" },
    "./pdf": { "types": "./dist/esm/pdf/index.d.ts", "import": "./dist/esm/pdf/index.js" },
    "./dataviz": { "types": "./dist/esm/dataviz/index.d.ts", "import": "./dist/esm/dataviz/index.js" },
    "./subtitles": { "types": "./dist/esm/subtitles/index.d.ts", "import": "./dist/esm/subtitles/index.js" },
    "./package.json": "./package.json"
  },
  "bin": {
    "cinecode": "./dist/esm/cli/main.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist/",
    "cinecode.schema.json",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@napi-rs/canvas": "^1.0.11",
    "commander": "^15.0.0",
    "earcut": "^3.2.4",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "svg-parser": "^2.1.0",
    "svgo": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/earcut": "^3.2.4",
    "@types/node": "^24.19.1",
    "@types/opentype.js": "^1.3.10",
    "@types/prompts": "^2.4.9"
  }
}
