{
  "name": "cinecode",
  "version": "1.0.0",
  "description": "Code-first media generation framework",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    },
    "./cli/main.js": {
      "types": "./dist/esm/cli/main.d.ts",
      "import": "./dist/esm/cli/main.js",
      "require": "./dist/cjs/cli/main.cjs"
    },
    "./package.json": "file:./package.json"
  },
  "typesVersions": {
    "*": {
      "cli/main.js": [
        "dist/esm/cli/main.d.ts"
      ],
      "cli/main": [
        "dist/esm/cli/main.d.ts"
      ]
    }
  },
  "bin": {
    "cinecode": "./dist/esm/cli/main.js"
  },
  "files": [
    "dist/",
    "cinecode.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "generate:schema": "node ./scripts/generate-schema.mjs",
    "build:esm": "node ./scripts/build.esm.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "node ./scripts/test.mjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@napi-rs/canvas": "^1.0.11",
    "@noble/ed25519": "^3.2.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/earcut": "^3.2.4",
    "@types/opentype.js": "^1.3.10",
    "@types/prompts": "^2.4.9",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "earcut": "^3.2.4",
    "midi": "^2.0.0",
    "opentype.js": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "picocolors": "^1.1.1",
    "prom-client": "^15.1.3",
    "prompts": "^2.4.2",
    "svg-parser": "2.1.0",
    "svgo": "^4.1.0",
    "wgpu-matrix": "^3.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/commander": "^2.12.5",
    "@types/node": "^24.19.1",
    "canvas": "^3.2.3"
  },
  "keywords": [
    "video",
    "animation",
    "renderer",
    "ffmpeg",
    "media",
    "codegen"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/cinecode/cinecode"
  },
  "bugs": {
    "url": "https://github.com/cinecode/cinecode/issues"
  }
}
