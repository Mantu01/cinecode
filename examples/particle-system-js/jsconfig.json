{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "cinecode": ["../../packages/cinecode/src"]
    }
  },
  "include": ["main.js", "cinecode.config.js", "src/**/*.js"],
  "exclude": ["node_modules", "output", ".cinecode"]
}