{
  "name": "cinecode-workspace",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "node scripts/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:source": "node scripts/check-source.mjs",
    "check:errors": "node scripts/check-errors.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "check:options": "node scripts/check-options.mjs",
    "check:preflight": "node scripts/check-preflight.mjs",
    "check:envelope": "node scripts/check-envelope.mjs",
    "check:surface": "node scripts/check-surface.mjs",
    "check:consumers": "node scripts/check-config-consumers.mjs",
    "check:config-load": "node scripts/check-config-load.mjs",
    "check:manifest-contract": "node scripts/check-manifest-contract.mjs",
    "check:entry-resolution": "node scripts/check-entry-resolution.mjs",
    "check:builder-semantics": "node scripts/check-builder-semantics.mjs",
    "check:audio-contract": "node scripts/check-audio-contract.mjs",
    "check:media-policy": "node scripts/check-media-policy.mjs",
    "check:output-plans": "node scripts/check-output-plans.mjs",
    "check:render-unification": "node scripts/check-render-unification.mjs",
    "check:validation-engine": "node scripts/check-validation-engine.mjs",
    "check:doctor-health": "node scripts/check-doctor-health.mjs",
    "check:maintenance": "node scripts/check-maintenance.mjs",
    "check:first-run": "node scripts/check-first-run.mjs",
    "check:preview-host": "node scripts/check-preview-host.mjs",
    "check:preview-engine": "node scripts/check-preview-engine.mjs",
    "check:dev-incremental": "node scripts/check-dev-incremental.mjs",
    "check:binary-decode": "node scripts/check-binary-decode.mjs",
    "check:resources": "node scripts/check-resources.mjs",
    "check:surface-prune": "node scripts/check-surface-prune.mjs",
    "check:version-lockstep": "node scripts/check-version-lockstep.mjs",
    "check:acceptance": "node scripts/acceptance-sweep.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "generate:docs": "node scripts/generate-docs.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:artifact": "node scripts/gate/install-gate.mjs",
    "verify:artifact:full": "node scripts/gate/install-gate.mjs --full"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "prettier": "3.9.9",
    "turbo": "^2.11.7",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "commander": "^15.0.0"
  }
}
